{
  "name": "codexsana-emergency-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "verify:qr": "node scripts/verify-qr.cjs",
    "verify:cards": "node scripts/verify-card-formats.cjs",
    "format": "prettier --write src scripts docs README.md *.json *.ts *.mjs",
    "format:check": "prettier --check src scripts docs README.md *.json *.ts *.mjs",
    "verify:structure": "node scripts/verify-structure.cjs",
    "verify:patients": "node scripts/verify-patients.cjs",
    "inventory:phase0": "node scripts/inventory-phase0.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    }
  }
